{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Reason Network Windows 桌面的默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "dialog:default",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
