+    pub(super) fn listener_state(&self) -> Option<TeamState> {
+        let g = self.inner.lock().unwrap();
+        g.team.clone().or_else(|| g.store.prefixed("dissolved:").ok()?.into_iter()
+            .find_map(|(_, v)| serde_json::from_str(&v).ok()))
+    }
+
+    pub(crate) fn archived_state(&self, id: &str, peer: &EndpointId) -> Option<TeamState> {
+        let g = self.inner.lock().unwrap();
+        let state: TeamState = serde_json::from_str(&g.store.get(&format!("dissolved:{id}")).ok()??).ok()?;
+        state.member(peer).map(|_| state.without_secrets())
+    }
+
+    fn archive_dissolution(&self, g: &mut Inner, state: &TeamState) -> Result<()> {
+        g.store.set(&format!("dissolved:{}",state.id), &serde_json::to_string(&state.without_secrets())?)?;
+        g.store.delete_prefix("team")?;
+        g.team = None;
+        g.store.delete_prefix("presence:")?;
+        Ok(())
+    }
+
+    pub(super) fn dissolve(self: &Arc<Self>, id: &str) -> Result<()> {
+        let state = {
+            let mut g = self.inner.lock().unwrap();
+            let mut state = g.team.clone().filter(|t| t.id == id).ok_or_else(|| anyhow!("Network changed"))?;
+            if state.founder != self.key.public() { bail!("Only the founding device can manage this Network"); }
+            for m in state.active().cloned().collect::<Vec<_>>() {
+                state.put_member(&self.key, m.endpoint, &m.person, &m.machine, false);
+            }
+            state.dissolved = Some(team::Signed::new(true, &self.key, id, "dissolved"));
+            self.archive_dissolution(&mut g, &state)?;
+            state
+        };
+        if let Some(net) = self.net() { net.broadcast(&Wire::State { state: Box::new(state.without_secrets()) }); }
+        self.restart_soon();
+        Ok(())
+    }
