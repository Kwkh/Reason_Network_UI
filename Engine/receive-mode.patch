 impl Daemon {
+    pub(super) async fn set_receive_mode(&self, key: &str, network: &str, mode: Tier) -> Result<Tier> {
+        // Probe outside the daemon lock and never inject a test message into a real thread.
+        if mode == Tier::Push {
+            let cmd = agent::command_for("codex").ok_or_else(|| anyhow!("后台找不到 Codex 命令行工具。"))?;
+            let mut cmd = tokio::process::Command::from(cmd);
+            let output = tokio::time::timeout(std::time::Duration::from_secs(3),
+                cmd.args(["queue", "--help"]).stdin(std::process::Stdio::null()).kill_on_drop(true).output())
+                .await.map_err(|_| anyhow!("检查 Codex 推送通道超时。"))?
+                .map_err(|e| anyhow!("无法启动 Codex 检查推送通道：{e}"))?;
+            let help = String::from_utf8_lossy(&output.stdout);
+            if !output.status.success() || !help.contains("--thread") || !help.contains("--message") {
+                bail!("当前 Codex 命令行版本不支持按线程排队投递，请更新 Codex。");
+            }
+        }
+        let mut g = self.inner.lock().unwrap();
+        self.prune(&mut g);
+        if g.team.as_ref().map(|t| t.id.as_str()) != Some(network) { bail!("当前 Network 已变化，请刷新。"); }
+        let live = g.live.get(key).ok_or_else(|| anyhow!("本机会话已离线，请重新接入。"))?;
+        if live.reg.agent != "codex" || mode == Tier::None { bail!("该会话不支持此接收模式。"); }
+        if mode == Tier::Push && let Some(reason) = live.push_problem() { bail!("{reason}"); }
+        if mode == Tier::Turn && live.last_hook.is_none() { bail!("该会话尚未建立回合接收通道，请在 Codex 中运行一个回合后重试。"); }
+        g.store.set(&format!("receive-mode:{key}"), mode.as_str())?;
+        let live = g.live.get_mut(key).expect("validated under lock");
+        live.preferred_mode = Some(mode);
+        let effective = live.effective_tier();
+        drop(g);
+        self.presence_changed();
+        Ok(effective)
+    }
