+impl Live {
+    fn hook_mode(&self) -> Tier {
+        if self.last_hook.is_some() { Tier::Turn } else { Tier::Pull }
+    }
+
+    fn push_problem(&self) -> Option<&'static str> {
+        if self.reg.agent_session_id.as_deref().is_none_or(str::is_empty) {
+            Some("后台没有收到这个 Codex 对话的线程 ID。")
+        } else if self.push_failed {
+            Some("这个会话上一次即时投递失败，请在 Codex 中重新打开该对话后再试。")
+        } else if agent::find_bin("codex").is_none() {
+            Some("后台找不到 Codex 命令行工具。")
+        } else {
+            None
+        }
+    }
+
+    pub(super) fn effective_tier(&self) -> Tier {
+        match self.preferred_mode {
+            Some(Tier::Push) if self.push_problem().is_some() => self.hook_mode(),
+            Some(Tier::Turn) => self.hook_mode(),
+            Some(mode) => mode,
+            None => self.reg.tier,
+        }
+    }
+}
