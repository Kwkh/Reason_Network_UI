+/// Only the live, unambiguous host of this native conversation can supply its state.
+pub fn activity(id: &str) -> Option<crate::doing::TurnActivity> {
+    let socket = endpoint(id)?;
+    let path = socket.with_extension("sock.activity");
+    let meta = path.symlink_metadata().ok()?;
+    if !meta.is_file() || meta.len() > 8 { return None; }
+    let updated = meta.modified().ok()?;
+    if socket.metadata().ok()?.created().is_ok_and(|created| updated < created) { return None; }
+    let running = match std::fs::read_to_string(path).ok()?.as_str() {
+        "running" => true,
+        "idle" => false,
+        _ => return None,
+    };
+    Some(crate::doing::TurnActivity { running, at: updated.duration_since(std::time::UNIX_EPOCH).ok()?.as_millis() as i64 })
