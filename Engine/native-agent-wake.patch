diff --git a/src/dsh-wake.mjs b/src/dsh-wake.mjs
new file mode 100644
index 0000000..a213736
--- /dev/null
+++ b/src/dsh-wake.mjs
@@ -0,0 +1,59 @@
+// Cordis loads this plugin inside the host that owns the original dsh agent.
+import { createHash, randomUUID } from 'node:crypto'
+import { lstatSync, mkdirSync } from 'node:fs'
+import { createServer } from 'node:net'
+
+export const name = 'reason-network-wake'
+export const inject = ['agents']
+export function apply(ctx) {
+  if (process.platform !== 'darwin') return
+  const root = '/tmp/reason-dsh-' + process.getuid()
+  mkdirSync(root, { recursive: true, mode: 0o700 })
+  const dir = lstatSync(root)
+  if (!dir.isDirectory() || dir.uid !== process.getuid() || (dir.mode & 0o077)) {
+    throw new Error('Reason Network requires a private dsh wake directory')
+  }
+  const servers = new Map()
+  function attach(agent) {
+    if (servers.has(agent) || agent.session.header.origin === 'subagent') return
+    const id = agent.session.header.id
+    const prefix = createHash('sha256').update(id).digest('hex').slice(0, 32)
+    const seen = new Set()
+    const server = createServer(socket => {
+      socket.on('error', () => socket.destroy())
+      socket.setTimeout(5000, () => socket.destroy())
+      let body = Buffer.alloc(0)
+      socket.on('data', chunk => {
+        if (body.length + chunk.length > 1024 * 1024) return socket.destroy()
+        body = Buffer.concat([body, chunk])
+        if (!body.includes(10)) return
+        socket.removeAllListeners('data')
+        try {
+          const req = JSON.parse(body.toString('utf8'))
+          if (req.session !== id || ctx.agents.get(id) !== agent || !servers.has(agent) ||
+              typeof req.text !== 'string' || typeof req.delivery !== 'string') return socket.destroy()
+          if (!seen.has(req.delivery)) {
+            agent.followup(Object.freeze({ id: randomUUID(), role: 'user', source: { kind: 'user' },
+              content: [{ type: 'text', text: req.text }] }))
+            seen.add(req.delivery)
+          }
+          socket.end('accepted\n')
+        } catch { socket.end('rejected\n') }
+      })
+    })
+    servers.set(agent, server)
+    server.on('error', e => ctx.logger.warn('Reason Network wake: ' + e.message))
+    server.listen(root + '/' + prefix + '-' + process.pid + '.sock')
+  }
+  function detach(agent) {
+    const server = servers.get(agent)
+    servers.delete(agent)
+    if (server) server.close()
+  }
+  ctx.effect(() => {
+    ctx.on('agent/created', ({agent}) => attach(agent))
+    ctx.on('agent/disposed', ({agent}) => detach(agent))
+    for (const agent of ctx.agents.list()) attach(agent)
+    return () => { for (const agent of servers.keys()) detach(agent) }
+  })
+}
diff --git a/src/dsh_wake.rs b/src/dsh_wake.rs
new file mode 100644
index 0000000..e4ae3af
--- /dev/null
+++ b/src/dsh_wake.rs
@@ -0,0 +1,42 @@
+use std::path::PathBuf;
+
+pub fn endpoint(id: &str) -> Option<PathBuf> {
+    #[cfg(target_os = "macos")]
+    {
+        use std::os::unix::fs::{FileTypeExt, MetadataExt};
+        let uid = unsafe { libc::geteuid() };
+        let dir = PathBuf::from(format!("/tmp/reason-dsh-{uid}"));
+        let meta = dir.symlink_metadata().ok()?;
+        if !meta.is_dir() || meta.uid() != uid || meta.mode() & 0o077 != 0 { return None; }
+        let digest = ring::digest::digest(&ring::digest::SHA256, id.as_bytes());
+        let prefix: String = digest.as_ref()[..16].iter().map(|b| format!("{b:02x}")).collect();
+        let mut matches = std::fs::read_dir(dir).ok()?.flatten().filter_map(|entry| {
+            let name = entry.file_name();
+            let pid = name.to_str()?.strip_prefix(&prefix)?.strip_prefix('-')?.strip_suffix(".sock")?.parse().ok()?;
+            (crate::util::pid_alive(pid) && entry.file_type().ok()?.is_socket()).then(|| entry.path())
+        });
+        let path = matches.next()?;
+        matches.next().is_none().then_some(path)
+    }
+    #[cfg(not(target_os = "macos"))]
+    { let _ = id; None }
+}
+
+pub fn post(id: &str, delivery: &str, text: &str) -> anyhow::Result<()> {
+    #[cfg(unix)]
+    {
+        use std::io::{Read, Write};
+        use std::time::Duration;
+        let path = endpoint(id).ok_or_else(|| anyhow::anyhow!("dsh session endpoint unavailable or ambiguous"))?;
+        let mut stream = std::os::unix::net::UnixStream::connect(path)?;
+        stream.set_write_timeout(Some(Duration::from_secs(5)))?;
+        stream.set_read_timeout(Some(Duration::from_secs(5)))?;
+        writeln!(stream, "{}", serde_json::json!({"session":id,"delivery":delivery,"text":text}))?;
+        let mut reply = [0; 9];
+        stream.read_exact(&mut reply)?;
+        anyhow::ensure!(&reply == b"accepted\n", "dsh did not accept the input");
+        Ok(())
+    }
+    #[cfg(not(unix))]
+    { let _ = (id, delivery, text); anyhow::bail!("dsh native wake unavailable") }
+}
