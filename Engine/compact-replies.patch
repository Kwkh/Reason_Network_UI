new file mode 100644
--- /dev/null
+++ b/src/reply_ref.rs
@@ -0,0 +1,46 @@
+//! Local reply addresses for native agent prompts. Only the original thread can resolve one.
+//! Never recycle a code; a missing index or expired parent must fail closed.
+use anyhow::{Context, Result, ensure};
+use rusqlite::{Connection, OpenFlags, params};
+use std::time::Duration;
+
+const PREFIX: &str = "reply::";
+
+fn index(write: bool) -> Result<Connection> {
+    let path = crate::paths::user_home().join(".reason/network/reply-refs.sqlite3");
+    let flags = if write { OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_CREATE }
+        else { OpenFlags::SQLITE_OPEN_READ_ONLY };
+    let db = Connection::open_with_flags(path, flags)?;
+    db.busy_timeout(Duration::from_millis(80))?;
+    Ok(db)
+}
+
+pub fn remember(team: &str, key: &str, msg: &crate::proto::Message) -> Result<String> {
+    let db = index(true)?;
+    db.execute_batch("CREATE TABLE IF NOT EXISTS refs(code TEXT PRIMARY KEY,team TEXT NOT NULL,
+        thread TEXT NOT NULL,parent TEXT NOT NULL,peer TEXT NOT NULL,UNIQUE(team,thread,parent,peer))")?;
+    let args = params![team,key,msg.id,msg.from];
+    db.execute("INSERT OR IGNORE INTO refs VALUES(hex(randomblob(5)),?1,?2,?3,?4)", args)?;
+    let code: String = db.query_row("SELECT code FROM refs WHERE team=?1 AND thread=?2 AND parent=?3 AND peer=?4",
+        args, |r| r.get(0))?;
+    Ok(format!("{PREFIX}{code}"))
+}
+
+pub fn lookup(address: &str, key: &str) -> Result<Option<(String,String,String)>> {
+    let Some(code) = address.strip_prefix(PREFIX) else { return Ok(None) };
+    ensure!(code.len() == 10 && code.bytes().all(|b| b.is_ascii_hexdigit()), "Invalid reply address");
+    let db = index(false).context("Local reply index unavailable; check the original message")?;
+    db.query_row("SELECT team,peer,parent FROM refs WHERE code=?1 AND thread=?2",
+        params![code.to_ascii_uppercase(),key], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?)))
+        .map(Some).context("Unknown reply address for this conversation; check the original message")
+}
+
+pub fn expand(req: &mut crate::proto::Request) -> Result<()> {
+    let crate::proto::Request::Send { from, to, reply_to, .. } = req else { return Ok(()) };
+    let Some((team, peer, parent)) = lookup(to, from)? else { return Ok(()) };
+    let qualified = format!("{team}::{parent}");
+    ensure!(reply_to.as_ref().is_none_or(|id| id == &qualified || id == &parent), "Conflicting reply address and parent");
+    *to = format!("{team}::{peer}");
+    *reply_to = Some(qualified);
+    Ok(())
+}
