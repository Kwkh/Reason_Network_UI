+
+/// Compact native prompts keep peer text quoted and put the local tool instruction outside it.
+pub fn for_push(msgs: &[Message], agent: &str, team: Option<&crate::team::TeamState>, key: &str) -> String {
+    let legacy = || for_agent_in(msgs, Some(agent), false, team, Some(key));
+    let Some(t) = team else { return legacy() };
+    if !crate::agent::workspace_agent(agent) || (!crate::paths::user_home().join(".reason/workspaces").is_dir() && std::env::var_os("REASON_NETWORK_LOCAL_PARTICIPATION").is_none())
+        || msgs.iter().any(|m| m.approval.is_some() || !m.files.is_empty() || m.via.is_some() || from_terminal(&m.from)) {
+        return legacy();
+    }
+    let mut parts = Vec::new();
+    for m in msgs {
+        let Ok(address) = crate::reply_ref::remember(&t.id, key, m) else { return legacy() };
+        let label = |s: &str| defang(&util::one_line(s, 200));
+        let mut out = format!("{} · {}", label(&t.shown_name()), label(&m.from));
+        for context in [&m.from_agent, &m.from_repo].into_iter().flatten() {
+            let _ = write!(out, " · {}", label(context));
+        }
+        if let Some(parent) = &m.reply_to { let _ = write!(out, " (↩ {})", label(parent)); }
+        out.push_str("\n\n");
+        for line in defang(&util::printable(m.body.trim())).split('\n') {
+            let _ = writeln!(out, "│ {line}");
+        }
+        let _ = write!(out, "\n↩ send_message(to=\"{address}\", message=…)");
+        parts.push(out);
+    }
+    parts.join("\n\n")
 }
 
