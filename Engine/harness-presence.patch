new file mode 100644
--- /dev/null
+++ b/src/harness.rs
@@ -0,0 +1,107 @@
+//! The lifetime of a user-facing harness. A saved thread and a detached wake server
+//! can both outlive it. Bind to a process incarnation so PID reuse cannot revive it.
+use std::path::PathBuf;
+
+pub fn tracked(agent: &str) -> bool {
+    matches!(agent, "codex" | "claude-code" | "dsh")
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub struct Process {
+    pid: u32,
+    started: (u64, u64),
+}
+
+fn process(pid: u32) -> Option<(Process, u32)> {
+    use std::mem::{MaybeUninit, size_of};
+    if pid < 2 || pid > i32::MAX as u32 { return None; }
+    let mut info = MaybeUninit::<libc::proc_bsdinfo>::uninit();
+    let size = size_of::<libc::proc_bsdinfo>() as i32;
+    // SAFETY: libproc initializes the entire struct on an exact-size return.
+    let count = unsafe { libc::proc_pidinfo(pid as i32, libc::PROC_PIDTBSDINFO, 0, info.as_mut_ptr().cast(), size) };
+    if count != size { return None; }
+    let info = unsafe { info.assume_init() };
+    if info.pbi_uid != unsafe { libc::geteuid() } || info.pbi_status == libc::SZOMB { return None; }
+    Some((Process { pid, started: (info.pbi_start_tvsec, info.pbi_start_tvusec) }, info.pbi_ppid))
+}
+
+fn path(pid: u32) -> Option<PathBuf> {
+    use std::ffi::CStr;
+    let mut buf = [0u8; 4096];
+    let n = unsafe { libc::proc_pidpath(pid as i32, buf.as_mut_ptr().cast(), buf.len() as u32) };
+    if n <= 0 { return None; }
+    Some(PathBuf::from(CStr::from_bytes_until_nul(&buf).ok()?.to_str().ok()?))
+}
+
+#[derive(Clone, Copy)]
+pub struct Owner {
+    host: Process,
+    desktop: Option<Process>,
+}
+
+impl Owner {
+    pub fn alive(self) -> bool {
+        let current = |p: Process| process(p.pid).is_some_and(|(found, _)| found == p);
+        current(self.host) && self.desktop.is_none_or(current)
+    }
+}
+
+fn desktop_paths(agent: &str) -> &'static [&'static str] {
+    match agent {
+        "codex" => &["ChatGPT.app/Contents/MacOS/ChatGPT", "Codex.app/Contents/MacOS/Codex"],
+        "dsh" => &["DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness"],
+        _ => &[],
+    }
+}
+
+fn desktop(agent: &str) -> Option<Owner> {
+    // A private fixture or a different profile must not borrow the login user's GUI.
+    let mut entry = std::mem::MaybeUninit::<libc::passwd>::uninit();
+    let mut buf = vec![0i8; 4096];
+    let mut result = std::ptr::null_mut();
+    let status = unsafe { libc::getpwuid_r(libc::geteuid(), entry.as_mut_ptr(), buf.as_mut_ptr(), buf.len(), &mut result) };
+    if status != 0 || result.is_null() { return None; }
+    let home = unsafe { std::ffi::CStr::from_ptr((*result).pw_dir) }.to_str().ok()?;
+    if crate::paths::user_home() != std::path::Path::new(home) { return None; }
+    let mut found = None;
+    for suffix in desktop_paths(agent) {
+        let name = suffix.rsplit('/').next()?;
+        let out = std::process::Command::new("/usr/bin/pgrep").args(["-x", name]).output().ok()?;
+        for pid in String::from_utf8_lossy(&out.stdout).lines().filter_map(|s| s.parse().ok()) {
+            if path(pid).is_some_and(|p| p.ends_with(suffix)) && let Some((host, _)) = process(pid) {
+                if found.is_some() { return None; }
+                found = Some(Owner { host, desktop: None });
+            }
+        }
+    }
+    found
+}
+
+pub fn resolve(agent: &str, id: &str, reported: Option<u32>, previous: Option<Owner>, joining: bool) -> Option<Owner> {
+    let previous = previous.filter(|p| p.alive());
+    let pid = match agent {
+        "claude-code" if reported.is_none() => crate::claude::scan().into_iter()
+            .find(|c| c.session_id.as_deref() == Some(id)).map(|c| c.pid),
+        "dsh" => crate::dsh_wake::endpoint_with_pid(id).map(|(_, pid)| pid).or(reported),
+        _ => reported,
+    };
+    let Some(pid) = pid else { return previous.or_else(|| joining.then(|| desktop(agent)).flatten()); };
+    let (host, mut parent) = process(pid)?;
+    if let Some(owner) = previous && owner.host == host { return Some(owner); }
+    // A launchd-owned Codex server can continue accepting queue requests after Quit.
+    // Only a separately witnessed original client may keep the session online.
+    if agent == "codex" && parent == 1 && path(pid).is_some_and(|p| p.file_name().is_some_and(|n| n == "codex")) {
+        return previous.or_else(|| desktop(agent));
+    }
+    let mut gui = None;
+    for _ in 0..12 {
+        if parent < 2 { break; }
+        let Some((ancestor, next)) = process(parent) else { break };
+        if path(parent).is_some_and(|p| desktop_paths(agent).iter().any(|suffix| p.ends_with(suffix))) {
+            gui = Some(ancestor);
+            break;
+        }
+        parent = next;
+    }
+    Some(Owner { host, desktop: gui })
+}
