diff --git a/src/store.rs b/src/store.rs
index 9c1dd47..231a9e4 100644
--- a/src/store.rs
+++ b/src/store.rs
@@ -587,6 +587,21 @@ impl Store {
         Ok(rows.collect::<rusqlite::Result<_>>()?)
     }
 
+    /// Commit the remote decision alongside the local membership change, including after an App restart.
+    pub fn end_membership(&self, network: &str, archive: Option<String>, notice: Option<String>) -> Result<()> {
+        let tx = self.db.unchecked_transaction()?;
+        if let Some(archive) = archive {
+            self.set(&format!("dissolved:{network}"), &archive)?;
+        }
+        if let Some(notice) = notice {
+            self.set(&format!("departure:{}", ulid::Ulid::generate()), &notice)?;
+        }
+        self.delete_prefix("team")?;
+        self.delete_prefix("presence:")?;
+        tx.commit()?;
+        Ok(())
+    }
+
     pub fn get(&self, key: &str) -> Result<Option<String>> {
         Ok(self.db.query_row("SELECT value FROM kv WHERE key = ?1", [key], |r| r.get(0)).optional()?)
     }
