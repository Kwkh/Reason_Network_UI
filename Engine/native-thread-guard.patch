@@ -12,6 +12,41 @@ use std::{
     sync::{Mutex, OnceLock},
 };
 
+/// Only native Codex UUIDs can be verified against the desktop thread index. Other
+/// agent identities and legacy process-based registrations follow the usual routing.
+pub(crate) fn unavailable(key: &str) -> bool {
+    let Some(id) = key.strip_prefix("codex:") else { return false };
+    if id.len() != 36 || !id.bytes().enumerate().all(|(i, b)| {
+        if matches!(i, 8 | 13 | 18 | 23) { b == b'-' } else { b.is_ascii_hexdigit() }
+    }) {
+        return false;
+    }
+    let root = std::env::var_os("CODEX_HOME").map(PathBuf::from)
+        .unwrap_or_else(|| crate::paths::user_home().join(".codex"));
+    indexed_active(&root, id) != Some(true)
+}
+
+fn indexed_active(root: &Path, id: &str) -> Option<bool> {
+    use rusqlite::{Connection, OpenFlags, OptionalExtension};
+    let (_, path) = std::fs::read_dir(root).ok()?.filter_map(|entry| {
+        let path = entry.ok()?.path();
+        let version = path.file_name()?.to_str()?.strip_prefix("state_")?.strip_suffix(".sqlite")?.parse::<u32>().ok()?;
+        Some((version, path))
+    }).max_by_key(|(version, _)| *version)?;
+    let db = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY).ok()?;
+    db.busy_timeout(std::time::Duration::ZERO).ok()?;
+    let mut stmt = db.prepare("SELECT * FROM threads WHERE id=? COLLATE NOCASE LIMIT 1").ok()?;
+    let active = stmt.query_row([id], |row| {
+        let field = |name| row.as_ref().column_index(name).ok();
+        let archived = field("archived").map(|i| row.get::<_, Option<i64>>(i)).transpose()?.flatten().unwrap_or(0);
+        let when = field("archived_at").map(|i| row.get_ref(i)).transpose()?;
+        let path = field("rollout_path").map(|i| row.get::<_, Option<String>>(i)).transpose()?.flatten();
+        Ok(archived == 0 && when.is_none_or(|v| v == rusqlite::types::ValueRef::Null)
+            && !path.is_some_and(|p| Path::new(&p).starts_with(root.join("archived_sessions"))))
+    }).optional().ok()?;
+    Some(active.unwrap_or(false))
+}
+
 /// How much is read at a time, from the end back, to find the last turn event.
 const CHUNK: u64 = 256 << 10;
 
