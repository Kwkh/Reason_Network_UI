 #[cfg(windows)]
-pub(crate) async fn resume_queued(_thread: &str) -> anyhow::Result<()> {
-    anyhow::bail!("Windows 暂不支持直接重试 Codex 控制套接字；消息已排队，打开原线程即可继续。")
+pub(crate) async fn resume_queued(thread: &str) -> anyhow::Result<()> {
+    ensure_resume_server().await?;
+    let root = std::env::var_os("CODEX_HOME").map(PathBuf::from)
+        .unwrap_or_else(|| crate::paths::user_home().join(".codex"));
+    let thread = thread.to_string();
+    tokio::task::spawn_blocking(move || resume_queued_blocking(&root, &thread))
+        .await
+        .map_err(|error| anyhow::anyhow!("Codex 控制连接任务失败：{error}"))?
+        .map_err(|error| anyhow::anyhow!("{error}；消息已排队，打开原线程即可继续。"))
+}
+
+#[cfg(windows)]
+fn resume_queued_blocking(root: &Path, thread: &str) -> anyhow::Result<()> {
+    use serde_json::{Value, json};
+    use tungstenite::Message;
+
+    let socket_path = root.join("app-server-control/app-server-control.sock");
+    let stream = uds_windows::UnixStream::connect(&socket_path)?;
+    let timeout = Some(std::time::Duration::from_secs(12));
+    stream.set_read_timeout(timeout)?;
+    stream.set_write_timeout(timeout)?;
+    let (mut socket, _) = tungstenite::client("ws://localhost", stream)
+        .map_err(|error| anyhow::anyhow!("连接 Codex 控制套接字失败：{error}"))?;
+    for (id, method, params) in [
+        (1, "initialize", json!({"clientInfo":{"name":"reason_network","version":"1","title":"Reason Network"}})),
+        (2, "thread/resume", json!({"threadId":thread})),
+    ] {
+        if id == 2 {
+            socket.send(Message::text(r#"{"method":"initialized"}"#))?;
+        }
+        let request = json!({"id":id,"method":method,"params":params});
+        socket.send(Message::text(request.to_string()))?;
+        loop {
+            let frame = socket.read()?;
+            let Message::Text(text) = frame else { continue };
+            let reply: Value = serde_json::from_str(text.as_str())?;
+            if reply["id"].as_i64() != Some(id) { continue; }
+            if reply.get("result").is_none()
+                || (id == 2 && reply["result"]["thread"]["id"].as_str() != Some(thread))
+            {
+                anyhow::bail!("Codex rejected {method}");
+            }
+            break;
+        }
+    }
+    Ok(())
 }
 
