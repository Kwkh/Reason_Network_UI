+#[cfg(all(test, windows))]
+mod uds_tests {
+    use super::*;
+
+    #[test]
+    fn resume_queued_speaks_websocket_over_unix_socket() {
+        let root = std::env::temp_dir().join(format!("rn-codex-uds-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let dir = root.join("app-server-control");
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("app-server-control.sock");
+        let listener = uds_windows::UnixListener::bind(&path).unwrap();
+        let thread_id = "11111111-1111-1111-1111-111111111111".to_string();
+        let server = {
+            let thread_id = thread_id.clone();
+            std::thread::spawn(move || {
+                let (stream, _) = listener.accept().unwrap();
+                let mut socket = tungstenite::accept(stream).unwrap();
+                loop {
+                    let Ok(tungstenite::Message::Text(text)) = socket.read() else { continue };
+                    let request: serde_json::Value = serde_json::from_str(text.as_str()).unwrap();
+                    match request["method"].as_str() {
+                        Some("initialize") => {
+                            socket.send(tungstenite::Message::text(r#"{"id":1,"result":{}}"#)).unwrap();
+                        }
+                        Some("thread/resume") => {
+                            let reply = serde_json::json!({"id":2,"result":{"thread":{"id":thread_id}}});
+                            socket.send(tungstenite::Message::text(reply.to_string())).unwrap();
+                            return;
+                        }
+                        _ => {}
+                    }
+                }
+            })
+        };
+        resume_queued_blocking(&root, &thread_id).unwrap();
+        server.join().unwrap();
+        let _ = std::fs::remove_dir_all(&root);
+    }
+}
