diff --git a/src/native_titles.rs b/src/native_titles.rs
new file mode 100644
--- /dev/null
+++ b/src/native_titles.rs
@@ -0,0 +1,218 @@
+//! Native session metadata for the local catalog and the titles advertised to peers.
+//! No transcript content is retained. Unchanged files are never decoded a second time.
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{HashMap, HashSet},
+    fs::{self, File},
+    io::{BufRead, BufReader, Read},
+    path::{Path, PathBuf},
+    sync::{Mutex, OnceLock},
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+#[derive(Clone, Serialize, Default)]
+pub struct Entry {
+    pub agent: String,
+    pub id: String,
+    pub title: Option<String>,
+    pub cwd: Option<String>,
+    pub project: Option<String>,
+    pub updated: f64,
+}
+
+#[derive(Deserialize, Default)]
+#[serde(default, rename_all = "camelCase")]
+struct Titles {
+    title: Option<String>,
+    summary: Option<String>,
+}
+#[derive(Deserialize, Default)]
+#[serde(default, rename_all = "camelCase")]
+struct Record {
+    id: Option<String>,
+    session_id: Option<String>,
+    cwd: Option<String>,
+    r#type: Option<String>,
+    ai_title: Option<String>,
+    custom_title: Option<String>,
+    summary: Option<String>,
+    slug: Option<String>,
+    title: Option<String>,
+    #[serde(rename = "$set")]
+    change: Option<Titles>,
+}
+
+fn update_text(value: Option<String>, dest: &mut Option<String>) {
+    if let Some(v) = value.filter(|v| !v.trim().is_empty()) {
+        *dest = Some(v);
+    }
+}
+
+fn entries(path: &Path) -> impl Iterator<Item = PathBuf> {
+    fs::read_dir(path).into_iter().flatten().flatten().map(|e| e.path())
+}
+
+fn version(path: &Path) -> Option<(u32, bool)> {
+    let name = path.file_name()?.to_str()?;
+    let plain = name.strip_suffix(".zstd").unwrap_or(name);
+    let prefix = plain.strip_suffix(".jsonl")?;
+    let version = if prefix == "session" { 0 } else { prefix.strip_prefix("session.v")?.parse().ok()? };
+    Some((version, plain == name))
+}
+
+fn decode(agent: &str, path: &Path, updated: SystemTime) -> Option<Entry> {
+    let file = File::open(path).ok()?;
+    let reader: Box<dyn Read> = if path.extension()?.to_str()? == "zstd" {
+        Box::new(zstd::stream::read::Decoder::new(file).ok()?)
+    } else {
+        Box::new(file)
+    };
+    let mut reader = BufReader::new(reader);
+    let mut e = Entry {
+        agent: agent.into(),
+        updated: updated.duration_since(UNIX_EPOCH).ok()?.as_secs_f64(),
+        ..Entry::default()
+    };
+    let (mut automatic, mut summary, mut slug) = (None, None, None);
+    if agent == "claude-code" {
+        e.id = path.file_stem()?.to_str()?.into();
+    }
+    if agent == "gemini" {
+        e.project = Some(path.parent()?.parent()?.file_name()?.to_str()?.into());
+    }
+    let mut visit = |r: Record| match agent {
+        "claude-code" => {
+            if e.cwd.is_none() {
+                e.cwd = r.cwd;
+            }
+            update_text(r.custom_title, &mut e.title);
+            update_text(r.ai_title, &mut automatic);
+            update_text(r.summary, &mut summary);
+            update_text(r.slug, &mut slug);
+        }
+        "dsh" => {
+            if e.id.is_empty()
+                && let Some(id) = r.id
+            {
+                e.id = id;
+                e.cwd = r.cwd;
+            }
+        }
+        "gemini" => {
+            // Regular transcript messages have their own id and can carry a title.
+            if r.id.is_some() && r.session_id.is_none() && r.change.is_none() {
+                return;
+            }
+            if e.id.is_empty()
+                && let Some(id) = r.session_id
+            {
+                e.id = id;
+            }
+            update_text(r.title, &mut e.title);
+            update_text(r.summary, &mut summary);
+            if let Some(update) = r.change {
+                update_text(update.title, &mut e.title);
+                update_text(update.summary, &mut summary);
+            }
+        }
+        _ => {}
+    };
+    let mut dsh_title = None;
+    if path.extension().and_then(|s| s.to_str()) == Some("json") {
+        // Deserialize metadata only; messages and attachments are skipped by serde.
+        visit(serde_json::from_reader(reader).ok()?);
+    } else {
+        let mut line = Vec::new();
+        loop {
+            line.clear();
+            if reader.read_until(b'\n', &mut line).ok()? == 0 {
+                break;
+            }
+            if let Ok(r) = serde_json::from_slice::<Record>(&line) {
+                if agent == "dsh" && r.r#type.as_deref() == Some("session/title") {
+                    #[derive(Deserialize)]
+                    struct TitleEvent {
+                        data: Titles,
+                    }
+                    if let Ok(event) = serde_json::from_slice::<TitleEvent>(&line) {
+                        update_text(event.data.title, &mut dsh_title);
+                    }
+                }
+                visit(r);
+            }
+        }
+    }
+    e.title = e.title.or(dsh_title).or(automatic).or(summary).or(slug);
+    (!e.id.is_empty()).then_some(e)
+}
+
+type Cached = (SystemTime, u64, Option<Entry>);
+pub fn catalog() -> Vec<Entry> {
+    static CACHE: OnceLock<Mutex<HashMap<PathBuf, Cached>>> = OnceLock::new();
+    let mut cache = CACHE.get_or_init(Default::default).lock().unwrap();
+    let mut visited = HashSet::new();
+    let mut result = Vec::new();
+    let mut add = |agent: &str, path: PathBuf| {
+        let Ok(meta) = path.metadata() else { return };
+        let Ok(mtime) = meta.modified() else { return };
+        visited.insert(path.clone());
+        if !cache.get(&path).is_some_and(|c| c.0 == mtime && c.1 == meta.len()) {
+            let row = decode(agent, &path, mtime);
+            cache.insert(path.clone(), (mtime, meta.len(), row));
+        }
+        if let Some(row) = cache.get(&path).and_then(|c| c.2.as_ref()) {
+            result.push(row.clone());
+        }
+    };
+    for project in entries(&crate::paths::claude_dir().join("projects")) {
+        for file in entries(&project).filter(|p| p.extension().is_some_and(|s| s == "jsonl")) {
+            add("claude-code", file);
+        }
+    }
+    let home = crate::paths::user_home();
+    let dsh = std::env::var_os("DSH_HOME")
+        .filter(|p| !p.to_string_lossy().trim().is_empty())
+        .map(PathBuf::from)
+        .unwrap_or_else(|| home.join(".dsh"));
+    for project in entries(&dsh.join("sessions")) {
+        for directory in entries(&project) {
+            if let Some((_, file)) = entries(&directory).filter_map(|p| Some((version(&p)?, p))).max_by_key(|(v, _)| *v)
+            {
+                add("dsh", file);
+            }
+        }
+    }
+    for project in entries(&home.join(".gemini/tmp")) {
+        for file in
+            entries(&project.join("chats")).filter(|p| p.extension().is_some_and(|s| s == "json" || s == "jsonl"))
+        {
+            add("gemini", file);
+        }
+    }
+    cache.retain(|p, _| visited.contains(p));
+    result.sort_by(|a, b| a.updated.total_cmp(&b.updated));
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn native_rename_after_long_records_and_compression() {
+        let dir = std::env::temp_dir().join(format!("reason-native-title-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        let filler = serde_json::json!({"message":"x".repeat(160_000)}).to_string();
+        let gemini = dir.join("gemini.jsonl");
+        fs::write(&gemini,format!("{{\"sessionId\":\"abc\",\"title\":\"old\"}}\n{filler}\n{{\"$set\":{{\"title\":\"renamed\"}}}}\n{{\"id\":\"message\",\"title\":\"not a chat title\"}}\n{filler}")).unwrap();
+        assert_eq!(decode("gemini", &gemini, SystemTime::now()).unwrap().title.as_deref(), Some("renamed"));
+        let dsh = dir.join("session.v4.jsonl.zstd");
+        let log = format!(
+            "{{\"id\":\"abc\",\"cwd\":\"/qa\"}}\n{filler}\n{{\"type\":\"session/title\",\"data\":{{\"title\":\"自定义标题\"}}}}\n{filler}"
+        );
+        fs::write(&dsh, zstd::encode_all(log.as_bytes(), 1).unwrap()).unwrap();
+        let e = decode("dsh", &dsh, SystemTime::now()).unwrap();
+        assert_eq!((e.id.as_str(), e.title.as_deref()), ("abc", Some("自定义标题")));
+        fs::remove_dir_all(dir).unwrap();
+    }
+}
