diff --git a/src/daemon/workspaces.rs b/src/daemon/workspaces.rs
new file mode 100644
index 0000000..b79821f
--- /dev/null
+++ b/src/daemon/workspaces.rs
@@ -0,0 +1,290 @@
+//! Workspace agents share one Codex MCP/hook installation. Route by confirmed team and native thread,
+//! independently of the window's selection. Local socket replies are never retried after a timeout.
+use super::*;
+use anyhow::bail;
+use rusqlite::{Connection, OpenFlags, OptionalExtension};
+use std::path::PathBuf;
+
+pub(super) fn root() -> PathBuf {
+    paths::user_home().join(".reason/workspaces")
+}
+pub(super) fn managed() -> bool {
+    paths::home().parent() == Some(root().as_path())
+}
+
+struct Workspace {
+    team: String,
+    name: String,
+    dir: PathBuf,
+}
+
+fn joined(key: &str) -> Result<Vec<Workspace>> {
+    let entries = match std::fs::read_dir(root()) {
+        Ok(entries) => entries,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(vec![]),
+        Err(e) => return Err(e.into()),
+    };
+    let mut found = Vec::new();
+    for entry in entries {
+        let entry = entry?;
+        if !entry.file_type()?.is_dir() {
+            continue;
+        }
+        let dir = entry.path();
+        let path = dir.join("network.db");
+        if !path.is_file() {
+            continue;
+        }
+        let db = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+        db.busy_timeout(std::time::Duration::from_millis(500))?;
+        if !db.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='kv')", [], |r| r.get::<_, bool>(0))? {
+            continue;
+        }
+        let member = format!("workspace-member:{key}");
+        let item = db
+            .query_row(
+                "SELECT json_extract(value,'$.id'),json_extract(value,'$.meta.body.name') FROM kv
+            WHERE key='team' AND EXISTS(SELECT 1 FROM kv m WHERE m.key=? AND m.value=json_extract(kv.value,'$.id'))",
+                [member],
+                |r| Ok((r.get::<_, String>(0)?, r.get::<_, Option<String>>(1)?)),
+            )
+            .optional()?;
+        if let Some((team, name)) = item {
+            found.push(Workspace { name: name.unwrap_or_else(|| team.clone()), team, dir });
+        }
+    }
+    Ok(found)
+}
+
+impl Workspace {
+    async fn call(&self, request: &Request) -> Result<Value> {
+        let path = paths::socket_in(&self.dir);
+        let result = tokio::time::timeout(Duration::from_secs(32), async {
+            let stream = tokio::net::UnixStream::connect(path).await?;
+            let (read, mut write) = stream.into_split();
+            let mut frame =
+                serde_json::to_vec(&json!({"id":1,"op":"workspace_dispatch","network":self.team,"request":request}))?;
+            frame.push(b'\n');
+            write.write_all(&frame).await?;
+            let line =
+                BufReader::new(read).lines().next_line().await?.ok_or_else(|| anyhow!("Workspace disconnected"))?;
+            let reply: Reply = serde_json::from_str(&line)?;
+            if !reply.ok {
+                bail!("{}", reply.error.unwrap_or_default());
+            }
+            Ok(reply.result.unwrap_or(Value::Null))
+        })
+        .await;
+        result.map_err(|_| anyhow!("Workspace timed out; check delivery before retrying"))?
+    }
+}
+
+impl Daemon {
+    pub(super) async fn dispatch(self: &Arc<Self>, conn: u64, mut req: Request) -> Result<Value> {
+        if let Request::WorkspaceDispatch { network, request } = req {
+            if self.team_id().as_ref() != Some(&network) {
+                bail!("Network membership changed");
+            }
+            let member = match request.as_ref() {
+                Request::Hook(h) => Some(format!("{}:{}", h.agent, h.session_id)),
+                Request::Who { me, .. } => me.clone(),
+                Request::Send { from, .. } | Request::DeliveryStatus { from, .. } => Some(from.clone()),
+                Request::Inbox { key, .. } | Request::Unread { key } | Request::Delivered { key, .. } => {
+                    Some(key.clone())
+                }
+                _ => None,
+            }
+            .ok_or_else(|| anyhow!("Workspace operation requires a session"))?;
+            {
+                let g = self.inner.lock().unwrap();
+                if g.store.get(&format!("workspace-member:{member}"))?.as_ref() != Some(&network) {
+                    bail!("Session no longer belongs to this Network");
+                }
+            }
+            return self.handle(conn, *request).await;
+        }
+        if managed() || !root().is_dir() {
+            return self.handle(conn, req).await;
+        }
+        let key = match &req {
+            Request::Send { from, .. } | Request::DeliveryStatus { from, .. } => from.clone(),
+            Request::Hook(h) if h.agent == "codex" => format!("codex:{}", h.session_id),
+            Request::Who { me: Some(key), .. }
+            | Request::Inbox { key, .. }
+            | Request::Unread { key }
+            | Request::Delivered { key, .. } => key.clone(),
+            Request::Register { session } => session.key.clone(),
+            _ => return self.handle(conn, req).await,
+        };
+        if !key.starts_with("codex:") {
+            return self.handle(conn, req).await;
+        }
+        let peers = joined(&key)?;
+        let local = self.team_id();
+        if let Request::DeliveryStatus { from, ids } = &req {
+            let mut receipts = self.inner.lock().unwrap().store.delivery_status(from, ids)?;
+            for ws in &peers {
+                let rows: Vec<Value> = serde_json::from_value(ws.call(&req).await?)?;
+                for (receipt, mut row) in receipts.iter_mut().zip(rows) {
+                    if row["stage"] != "unknown" {
+                        if receipt["stage"] != "unknown" {
+                            bail!("Ambiguous receipt ID across Networks");
+                        }
+                        row["network"] = json!(ws.team);
+                        *receipt = row;
+                    }
+                }
+            }
+            return Ok(json!(receipts));
+        }
+        if let Request::Send { to, reply_to, .. } = &mut req {
+            let dest = to.split_once("::");
+            let reply = reply_to.as_deref().and_then(|v| v.split_once("::"));
+            if let (Some((a, _)), Some((b, _))) = (dest, reply)
+                && a != b
+            {
+                bail!("Reply and destination belong to different Networks");
+            }
+            if let Some(scope) = dest.or(reply).map(|(id, _)| id.to_string()) {
+                if dest.is_none() {
+                    *to = format!("{scope}::{to}");
+                }
+                if local.as_ref() != Some(&scope) {
+                    let ws = peers
+                        .iter()
+                        .find(|w| w.team == scope)
+                        .ok_or_else(|| anyhow!("Session is not joined to that Network"))?;
+                    return ws.call(&req).await;
+                }
+            } else if !peers.is_empty() {
+                bail!(
+                    "Select a Network using the network-qualified address from list_team, or supply the message's qualified reply_to"
+                );
+            }
+            return self.handle(conn, req).await;
+        }
+        if peers.is_empty() {
+            return self.handle(conn, req).await;
+        }
+        let here = self.inner.lock().unwrap().live.contains_key(&key) && local.is_some();
+        match &req {
+            Request::Register { session } => {
+                let folder_allowed = !self.cfg.off_in(&session.cwd);
+                let registered = self.handle(conn, req).await;
+                match registered {
+                    Err(e) if e.to_string() == crate::config::OFF_HERE && folder_allowed => {
+                        Ok(json!({"address":"","name":"","unread":0}))
+                    }
+                    other => other,
+                }
+            }
+            Request::Hook(_) => {
+                let mut result = match self.handle(conn, req.clone()).await {
+                    Ok(v) => serde_json::from_value::<HookReply>(v)?,
+                    Err(e) if e.to_string() == crate::config::SESSION_PAUSED => HookReply::default(),
+                    Err(e) => return Err(e),
+                };
+                for ws in peers {
+                    // A worker may be restarting. Its unacknowledged mail remains in its own inbox.
+                    let Ok(v) = ws.call(&req).await else { continue };
+                    let reply: HookReply = serde_json::from_value(v)?;
+                    if result.address.is_none() {
+                        result.address = reply.address;
+                    }
+                    if let Some(t) = reply.text {
+                        result.text.get_or_insert_with(String::new).push_str(&format!("\n{t}"));
+                    }
+                    result.ids.extend(reply.ids.into_iter().map(|id| format!("{}::{id}", ws.team)));
+                }
+                Ok(json!(result))
+            }
+            Request::Who { .. } => {
+                let mut directory: Directory = serde_json::from_value(self.handle(conn, req.clone()).await?)?;
+                let original = directory.team.clone().unwrap_or_default();
+                directory.team = Some("Joined Networks".into());
+                if here {
+                    for s in &mut directory.sessions {
+                        s.address = format!("{}::{}", local.as_deref().unwrap_or(""), s.address);
+                        s.name = s.address.clone();
+                        s.doing = Some(format!("[{}] {}", original, s.doing.take().unwrap_or_default()));
+                    }
+                } else {
+                    directory.sessions.clear();
+                    directory.machines.clear();
+                }
+                for ws in peers {
+                    let Ok(response) = ws.call(&req).await else { continue };
+                    let d: Directory = serde_json::from_value(response)?;
+                    for mut s in d.sessions {
+                        s.address = format!("{}::{}", ws.team, s.address);
+                        s.name = s.address.clone();
+                        s.doing = Some(format!("[{}] {}", ws.name, s.doing.unwrap_or_default()));
+                        directory.sessions.push(s);
+                    }
+                    for m in d.machines {
+                        if !directory.machines.iter().any(|v| v.endpoint == m.endpoint) {
+                            directory.machines.push(m);
+                        }
+                    }
+                }
+                Ok(json!(directory))
+            }
+            Request::Unread { .. } => {
+                let mut u = if here { self.unread(&key)? } else { Unread { count: 0, from: vec![] } };
+                for ws in peers {
+                    if let Ok(v) = ws.call(&req).await {
+                        let more: Unread = serde_json::from_value(v)?;
+                        u.count += more.count;
+                        u.from.extend(more.from);
+                    }
+                }
+                Ok(json!(u))
+            }
+            Request::Delivered { ids, .. } => {
+                let mut local_ids = Vec::new();
+                for id in ids {
+                    if let Some((team, raw)) = id.split_once("::") {
+                        let ws =
+                            peers.iter().find(|w| w.team == team).ok_or_else(|| anyhow!("Network no longer joined"))?;
+                        ws.call(&Request::Delivered { key: key.clone(), ids: vec![raw.into()] }).await?;
+                    } else {
+                        local_ids.push(id.clone());
+                    }
+                }
+                if local_ids.is_empty() {
+                    Ok(Value::Null)
+                } else {
+                    self.handle(conn, Request::Delivered { key, ids: local_ids }).await
+                }
+            }
+            Request::Inbox { wait_secs, peek, .. } => {
+                let end = tokio::time::Instant::now() + Duration::from_secs((*wait_secs).min(MAX_WAIT));
+                let poll = Request::Inbox { key: key.clone(), wait_secs: 0, peek: *peek };
+                loop {
+                    let mut inbox = if here {
+                        self.inbox(key.clone(), 0, *peek).await?
+                    } else {
+                        Inbox { messages: vec![], text: String::new() }
+                    };
+                    for ws in &peers {
+                        let Ok(response) = ws.call(&poll).await else { continue };
+                        let mut more: Inbox = serde_json::from_value(response)?;
+                        for m in &mut more.messages {
+                            m.id = format!("{}::{}", ws.team, m.id);
+                        }
+                        inbox.messages.extend(more.messages);
+                        if !more.text.is_empty() {
+                            inbox.text.push('\n');
+                            inbox.text.push_str(&more.text);
+                        }
+                    }
+                    if !inbox.messages.is_empty() || tokio::time::Instant::now() >= end {
+                        return Ok(json!(inbox));
+                    }
+                    tokio::time::sleep(Duration::from_millis(450)).await;
+                }
+            }
+            _ => self.handle(conn, req).await,
+        }
+    }
+}
