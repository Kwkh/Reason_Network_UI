+/// Darwin reports native flock writers through F_GETLK. This query never obtains
+/// a lock, so observing a desktop thread cannot make the desktop lose a lease.
+#[cfg(target_os = "macos")]
+pub(crate) fn has_writer(id: &str) -> Option<bool> {
+    use std::os::fd::AsRawFd;
+    if !native_id(id) { return None; }
+    let root = std::env::var_os("CODEX_HOME").map(PathBuf::from)
+        .unwrap_or_else(|| crate::paths::user_home().join(".codex"));
+    let dir = root.join("thread-writer-locks");
+    if !dir.is_dir() { return None; } // Older Codex: use its native queue --resume.
+    let file = match File::open(dir.join(format!("{id}.lock"))) {
+        Ok(file) => file,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Some(false),
+        Err(_) => return None,
+    };
+    let mut lock = libc::flock { l_start: 0, l_len: 0, l_pid: 0, l_type: libc::F_WRLCK,
+        l_whence: libc::SEEK_SET as i16 };
+    let rc = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETLK, &mut lock) };
+    (rc == 0).then_some(lock.l_type != libc::F_UNLCK)
+}
