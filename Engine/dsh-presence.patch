diff --git a/src/daemon/dsh_presence.rs b/src/daemon/dsh_presence.rs
new file mode 100644
--- /dev/null
+++ b/src/daemon/dsh_presence.rs
@@ -0,0 +1,59 @@
+//! The desktop plugin opens one socket per loaded native conversation, even when several
+//! conversations share a process. A daemon restart or an idle reopen need not produce a hook.
+use super::*;
+
+impl Daemon {
+    pub(super) async fn dsh_presence_loop(self: Arc<Self>) {
+        loop {
+            if let Err(error) = self.refresh_dsh_presence().await {
+                log(&format!("dsh presence refresh: {error}"));
+            }
+            tokio::time::sleep(Duration::from_secs(4)).await;
+        }
+    }
+
+    async fn refresh_dsh_presence(self: &Arc<Self>) -> Result<()> {
+        let (team, sessions) = {
+            let g = self.inner.lock().unwrap();
+            let Some(team) = &g.team else { return Ok(()) };
+            (team.id.clone(), g.store.joined_dsh_sessions(&team.id)?)
+        };
+        for session in sessions {
+            let key = session.key;
+            let Some(id) = key.strip_prefix("dsh:").filter(|id| !id.is_empty()) else { continue };
+            let endpoint = crate::dsh_wake::endpoint_with_pid(id);
+            {
+                let mut g = self.inner.lock().unwrap();
+                if let Some(live) = g.live.get_mut(&key) {
+                    if endpoint.is_some() {
+                        live.dsh_endpoint_seen = true;
+                    } else if live.dsh_endpoint_seen {
+                        // The native conversation closed while its desktop process stayed alive.
+                        g.live.remove(&key);
+                        g.owners.remove(&key);
+                        self.presence_changed();
+                    }
+                    continue;
+                }
+            }
+            let Some((socket, pid)) = endpoint else { continue };
+            // A pathname can survive an unclean exit. Connect without writing any user input.
+            let Ok(Ok(_probe)) = tokio::time::timeout(Duration::from_millis(250), tokio::net::UnixStream::connect(socket)).await else { continue };
+            // Registration restores an existing identity. Reading its working directory here
+            // would serialize every recovery behind Git and macOS folder access.
+            drop(_probe);
+            let git = GitInfo { root: None, repo: session.repo, branch: session.branch };
+            let reg = SessionReg { key: key.clone(), agent: "dsh".into(), agent_session_id: Some(id.into()),
+                cwd: session.cwd, tier: Tier::Pull, pid: Some(pid), name: None };
+            match self.register_source(None, reg, git, false, None, Some(&team)) {
+                Ok((_, (_, pending))) if !pending.is_empty() => {
+                    let mut g = self.inner.lock().unwrap();
+                    self.deliver(&mut g, &key, pending, true);
+                }
+                Err(error) => log(&format!("dsh presence restore: {error}")),
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+}
