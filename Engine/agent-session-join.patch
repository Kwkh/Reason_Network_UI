+fn managed_mcp_command(command: &str) -> bool {
+    let path = Path::new(command);
+    if [".local/bin/reason-network", ".reason/bin/reason-network"].iter().any(|p| path == home().join(p)) {
+        return true;
+    }
+    let root = home().join("Library/Application Support/Reason Network UI/Backend");
+    let Ok(rel) = path.strip_prefix(root) else { return false };
+    let mut parts = rel.iter().filter_map(|s| s.to_str());
+    matches!((parts.next(), parts.next(), parts.next()), (Some(hash), Some("reason-network"), None)
+        if hash.len() == 16 && hash.bytes().all(|b| b.is_ascii_hexdigit()))
+}
+
+pub fn update_agent_mcp_commands(exe: &Path) -> Result<()> {
+    anyhow::ensure!(exe.is_absolute() && exe.is_file(), "Installed Reason backend is missing");
+    let target = exe.to_str().ok_or_else(|| anyhow!("Invalid MCP executable path"))?;
+    let cfg = codex_home().join("config.toml");
+    if cfg.is_file() {
+        let mut doc: toml_edit::DocumentMut = std::fs::read_to_string(&cfg)?.parse()?;
+        if let Some(entry) = doc.get_mut("mcp_servers").and_then(|v| v.get_mut(AGENT_NAME))
+            && entry.get("args").and_then(|v| v.as_array()).is_some_and(|a| a.len() == 1 && a.get(0).and_then(|v| v.as_str()) == Some("mcp"))
+            && entry.get("command").and_then(|v| v.as_str()).is_some_and(|s| s != target && managed_mcp_command(s)) {
+            entry["command"] = toml_edit::value(target);
+            write_file(&cfg, &doc.to_string(), false)?;
+        }
+    }
+    for path in [home().join(".claude.json"), gemini_home().join("settings.json")] {
+        if !path.is_file() { continue; }
+        let mut v = read_json(&path)?;
+        let entry = &v["mcpServers"][AGENT_NAME];
+        if entry["args"] == json!(["mcp"]) && entry["command"].as_str().is_some_and(|s| s != target && managed_mcp_command(s)) {
+            v["mcpServers"][AGENT_NAME]["command"] = json!(target);
+            write_json(&path, &v, false)?;
+        }
+    }
     Ok(())
 }
 
