+/// The GUI can coexist with a stock CLI: hooks usually point at that CLI,
+/// while managed dsh profiles point at the separately installed backend.
+pub fn app_integrations(executables: &[PathBuf]) -> Value {
+    let mut paths: Vec<_> = executables.iter().filter(|p| p.is_file()).cloned().collect();
+    paths.extend(executables.iter().filter_map(|p| p.canonicalize().ok()));
+    paths.sort();
+    paths.dedup();
+    let configured = |command: Option<&str>| command.is_some_and(|c| paths.iter().any(|p| p == Path::new(c)));
+    let mut wired = Vec::new();
+    let hooks = std::fs::read_to_string(codex_home().join("hooks.json")).unwrap_or_default();
+    if let Ok(text) = std::fs::read_to_string(codex_home().join("config.toml"))
+        && let Ok(doc) = toml::from_str::<toml::Table>(&text)
+        && let Some(entry) = doc.get("mcp_servers").and_then(|s| s.get(AGENT_NAME))
+        && configured(entry.get("command").and_then(toml::Value::as_str))
+        && entry.get("enabled").and_then(toml::Value::as_bool) != Some(false)
+        && entry.get("args").and_then(toml::Value::as_array).is_some_and(|a| a.iter().any(|v| v.as_str() == Some("mcp")))
+        && hooks.contains("hook codex") && paths.iter().any(|p| contains(&hooks, &me(p)))
+    {
+        wired.push("codex");
+    }
+    // Claude setup adds a user-scoped MCP server. Read that scope directly;
+    // launching the interactive client to probe it can stall unrelated tools.
+    if let Ok(v) = read_json(&home().join(".claude.json"))
+        && configured(v["mcpServers"][AGENT_NAME]["command"].as_str())
+        && v["mcpServers"][AGENT_NAME]["args"].as_array().is_some_and(|a| a.iter().any(|v| v == "mcp"))
+    {
+        wired.push("claude-code");
+    }
+    if paths.iter().any(|p| gemini::wired(p)) { wired.push("gemini"); }
+    if let Ok(text) = std::fs::read_to_string(dsh_patch())
+        && paths.iter().any(|p| dsh_wired(&text, p))
+    {
+        wired.push("dsh");
+    }
+    json!(wired)
+}
