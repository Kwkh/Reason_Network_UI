+/// The registered tier is only a candidate until the installed CLI has been probed.
+const UPDATE_CODEX: &str = "当前 Codex 命令行工具不支持按线程投递并唤醒，请更新 Codex。";
+static QUEUE_ERROR: std::sync::RwLock<Option<&'static str>> =
+    std::sync::RwLock::new(Some("正在检查 Codex 推送通道。"));
+
+pub(crate) fn queue_problem() -> Option<&'static str> { *QUEUE_ERROR.read().unwrap() }
+
+pub(crate) async fn check_queue(force: bool) -> Option<&'static str> {
+    use std::time::{Duration, Instant, SystemTime};
+    type Signature = (PathBuf, u64, SystemTime);
+    static LAST: tokio::sync::Mutex<Option<(Option<Signature>, Instant)>> = tokio::sync::Mutex::const_new(None);
+    let mut last = LAST.lock().await;
+    let program = crate::agent::find_bin("codex");
+    let signature = program.as_ref().and_then(|path| {
+        let meta = path.metadata().ok()?;
+        Some((path.clone(), meta.len(), meta.modified().ok()?))
+    });
+    if !force && last.as_ref().is_some_and(|(sig, time)| sig == &signature && time.elapsed() < Duration::from_secs(60)) {
+        return queue_problem();
+    }
+    let problem = if let Some(path) = program {
+        let mut command = tokio::process::Command::from(crate::agent::command_at(&path));
+        match tokio::time::timeout(Duration::from_secs(3), command.args(["queue", "--help"])
+            .stdin(std::process::Stdio::null()).kill_on_drop(true).output()).await {
+            Err(_) => Some("检查 Codex 推送通道超时。"),
+            Ok(Err(_)) => Some("无法启动 Codex 命令行工具。"),
+            Ok(Ok(out)) => {
+                let help = String::from_utf8_lossy(&out.stdout);
+                let supports = ["--thread", "--message", "--resume"].iter().all(|flag|
+                    help.split_whitespace().any(|word| word.trim_matches(|c| matches!(c, '[' | ']' | ',')) == *flag));
+                (!out.status.success() || !supports).then_some(UPDATE_CODEX)
+            }
+        }
+    } else { Some("后台找不到 Codex 命令行工具。") };
+    *last = Some((signature, Instant::now()));
+    *QUEUE_ERROR.write().unwrap() = problem;
+    problem
+}
 
