+/// Ask the same CLI used for queueing to connect to its default per-user endpoint.
+pub(crate) async fn ensure_resume_server() -> anyhow::Result<()> {
+    async fn run(action: &str) -> anyhow::Result<std::process::Output> {
+        let command = crate::agent::command_for("codex")
+            .ok_or_else(|| anyhow::anyhow!("后台找不到 Codex 命令行工具。"))?;
+        Ok(tokio::time::timeout(std::time::Duration::from_secs(if action == "start" { 45 } else { 4 }),
+            tokio::process::Command::from(command).args(["app-server", "daemon", action])
+            .stdin(std::process::Stdio::null()).kill_on_drop(true).output()).await??)
+    }
+    if run("version").await.is_ok_and(|out| out.status.success()) { return Ok(()); }
+    let started = run("start").await?;
+    if !started.status.success() || !run("version").await?.status.success() {
+        anyhow::bail!("无法连接 Codex 唤醒服务，请检查 Codex 安装后重试。");
+    }
+    Ok(())
+}
+
+/// A queue warning means the message already exists. Retry only the native
+/// thread/resume request, with no message body or turn/start request.
+pub(crate) async fn resume_queued(thread: &str) -> anyhow::Result<()> {
+    use futures_util::{SinkExt, StreamExt};
+    use serde_json::{Value, json};
+    use tokio_websockets::{ClientBuilder, Message};
+    ensure_resume_server().await?;
+    let root = std::env::var_os("CODEX_HOME").map(PathBuf::from)
+        .unwrap_or_else(|| crate::paths::user_home().join(".codex"));
+    tokio::time::timeout(std::time::Duration::from_secs(12), async {
+        let socket = tokio::net::UnixStream::connect(root.join("app-server-control/app-server-control.sock")).await?;
+        let (mut ws, _) = ClientBuilder::from_uri("ws://localhost".parse()?).connect_on(socket).await?;
+        for (id,method,params) in [
+            (1, "initialize", json!({"clientInfo":{"name":"reason_network","version":"1","title":"Reason Network"}})),
+            (2, "thread/resume", json!({"threadId":thread})),
+        ] {
+            if id == 2 { ws.send(Message::text(r#"{"method":"initialized"}"#)).await?; }
+            let request = json!({"id":id,"method":method,"params":params});
+            ws.send(Message::text(request.to_string())).await?;
+            loop {
+                let frame = ws.next().await.ok_or_else(|| anyhow::anyhow!("Codex connection closed"))??;
+                let Some(text) = frame.as_text() else { continue };
+                let reply: Value = serde_json::from_str(text)?;
+                if reply["id"].as_i64() != Some(id) { continue; }
+                if reply.get("result").is_none() || (id == 2 && reply["result"]["thread"]["id"].as_str() != Some(thread)) {
+                    anyhow::bail!("Codex rejected {method}");
+                }
+                break;
+            }
+        }
+        Ok::<(),anyhow::Error>(())
+    }).await?
+}
